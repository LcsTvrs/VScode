{
  "name": "uniformes-leroy-merlin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "verify": "prisma generate && prisma validate && npm run lint && npm test && next build",
    "check:deploy-env": "tsx scripts/check-deploy-env.ts",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:ui": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:set-password": "tsx scripts/set-master-password.ts",
    "admin:inspect": "tsx scripts/inspect-admin-state.ts",
    "admin:bootstrap-existing": "tsx scripts/bootstrap-admin-existing.ts",
    "dev:refactor": "next dev --hostname 127.0.0.1 --port 3108"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "next": {
      "postcss": "8.5.31"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
