generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UniformCategory {
  CAMISETA
  CALCA
  JAQUETA
  COLETE
  OUTRO
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum UniformGender {
  MASCULINO
  FEMININO
}

enum RequestStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

enum UserRole {
  MASTER_ADMIN
  STORE_ADMIN
}

model Store {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  city            String
  state           String
  users           User[]
  employees       Employee[]
  uniformVariants UniformVariant[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  requests        UniformRequest[]
  requestItems    RequestItem[]
  createdAt       DateTime         @default(now())
}

model User {
  id                 String   @id @default(cuid())
  login              String   @unique
  name               String?
  passwordHash       String
  role               UserRole
  storeId            String?
  mustChangePassword Boolean  @default(true)
  passwordChangeDeadline DateTime?
  store              Store?   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([storeId, role])
}

model Employee {
  id        String           @id @default(cuid())
  ldap      String?
  name      String
  email     String?
  role      String           @default("Colaborador")
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  requests  UniformRequest[]
  createdAt DateTime         @default(now())

  @@unique([storeId, id])
  @@unique([storeId, ldap])
  @@unique([storeId, email])
  @@index([storeId, name])
}

model UniformVariant {
  id             String           @id @default(cuid())
  storeId        String
  sku            String
  name           String
  category       UniformCategory
  gender         UniformGender?
  size           String
  color          String
  imageId        String?
  image          UniformImage?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  requestItems   RequestItem[]
  createdAt      DateTime         @default(now())

  @@unique([storeId, id])
  @@unique([storeId, sku])
  @@index([storeId, category, size])
  @@index([imageId])
  @@index([sku])
}

model UniformImage {
  id        String           @id @default(cuid())
  data      Bytes
  createdAt DateTime         @default(now())
  variants  UniformVariant[]
}

model StockLevel {
  id        String         @id @default(cuid())
  storeId   String
  variantId String
  quantity  Int            @default(0)
  minimum   Int            @default(5)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant   UniformVariant @relation(fields: [storeId, variantId], references: [storeId, id], onDelete: Restrict)
  updatedAt DateTime       @updatedAt

  @@unique([storeId, variantId])
  @@index([storeId, quantity, minimum])
}

model StockMovement {
  id        String         @id @default(cuid())
  storeId   String
  variantId String
  type      MovementType
  quantity  Int
  note      String?
  createdAt DateTime       @default(now())
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant   UniformVariant @relation(fields: [storeId, variantId], references: [storeId, id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([storeId, variantId, createdAt])
}

model UniformRequest {
  id         String         @id @default(cuid())
  code       String
  employeeId String
  storeId    String
  status     RequestStatus  @default(PENDENTE)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  employee   Employee       @relation(fields: [storeId, employeeId], references: [storeId, id], onDelete: Restrict)
  store      Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items      RequestItem[]

  @@unique([storeId, id])
  @@unique([storeId, code])
  @@index([storeId, status, createdAt])
}

model RequestItem {
  id        String         @id @default(cuid())
  storeId   String
  requestId String
  variantId String
  quantity  Int
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  request   UniformRequest @relation(fields: [storeId, requestId], references: [storeId, id], onDelete: Cascade)
  variant   UniformVariant @relation(fields: [storeId, variantId], references: [storeId, id], onDelete: Restrict)

  @@unique([storeId, requestId, variantId])
  @@index([storeId, variantId])
}
